# Supabase project URL and anon/publishable key — safe to expose to the
# client. Find both under Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://wzjlqgkafsqwczfmxson.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YBPauuNddDdCKPqoNwJKOQ_ni_rYHhp

# Server-only service_role key — bypasses Row Level Security. Never expose to
