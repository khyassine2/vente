SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_get_from_supabase_dashboard_settings_api

# Password for the single-admin /admin login. Choose a strong value.
ADMIN_PASSWORD=REPLACE_ME_choose_a_strong_password
